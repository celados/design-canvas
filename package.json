{
	"name": "design-canvas",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"core:build": "bun --cwd packages/core build",
		"core:typecheck": "bun --cwd packages/core typecheck",
		"dev": "bun run routegen && vp dev web --port 3000 --strictPort",
		"routegen": "tsr generate",
		"test": "vp test --run --config vitest.config.ts",
		"check": "bun run core:build && bun run routegen && vp check && tsc -p web/tsconfig.json --noEmit && bun run registry:check",
		"build": "bun run routegen && vp build web",
		"registry:check": "shadcn registry validate ./registry.json"
	},
	"dependencies": {
		"@celados/design-canvas-core": "workspace:*",
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.38",
		"@tanstack/react-start": "^1.168.56",
		"html-to-image": "^1.11.13",
		"lucide-react": "^1.47.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/router-cli": "^1.167.38",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.0",
		"nitro": "^3.0.260610-beta",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
		"vite-plus": "^0.3.3",
		"vitest": "^4.1.11"
	}
}
