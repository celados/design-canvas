{
	"name": "design-canvas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run routegen && vp dev web --port 3000 --strictPort",
		"routegen": "tsr generate",
		"test": "vp test --run --config vitest.config.ts",
		"check": "bun run routegen && vp check && tsc -p web/tsconfig.json --noEmit && bun run registry:check",
		"build": "bun run routegen && vp build web",
		"registry:check": "shadcn registry validate ./registry.json"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-start": "^1.168.49",
		"html-to-image": "^1.11.13",
		"lucide-react": "^1.37.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "^4.19.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/router-cli": "^1.167.33",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.0.1",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.3.0",
		"vite-plus": "^0.3.0",
		"vitest": "^4.1.11"
	}
}
