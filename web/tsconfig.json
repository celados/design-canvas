{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@celados/harness/tsconfig/dom.json",
	"include": ["src", "vite.config.ts"],
	"exclude": ["dist", "node_modules"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": { "@/*": ["./src/*"] },
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
